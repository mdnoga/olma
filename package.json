{
  "name": "olma",
  "version": "0.1.0",
  "description": "OpenCode Local Model Assistant - TUI for managing local/LAN LLM providers",
  "type": "module",
  "main": "src/index.tsx",
  "bin": {
    "olma": "src/index.tsx"
  },
  "scripts": {
    "start": "bun src/index.tsx",
    "dev": "bun --watch src/index.tsx",
    "build": "bun build src/index.tsx --target=bun --compile --output olma",
    "typecheck": "tsc --noEmit",
    "lint": "bun x oxlint ."
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.0",
    "react-devtools-core": "^6.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "typescript": "^5.7.0"
  }
}
